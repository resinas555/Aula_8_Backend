3. CUIDADO COM PRECENDENCIA LÓGICA!
Clientes de 'SP' OU 'RJ' QUE tenham saldo maior que 100
Sempre use Parenteses para reagrupar o OR
SELECT nome, estado, saldo
FROM clientes
WHERE (estado = 'SP' OR estado = 'RJ') AND saldo > 100.00;   


SELECT nome_produto, preco
FROM produtos
ORDER BY preco DESC
LIMIT 3;

SELECT nome, estado, saldo
FROM clientes
ORDER BY saldo DESC, nome ASC;  





Tabela de Cursos de Música
CREATE TABLE IF NOT EXISTS cursos_musica (
    id SERIAL PRIMARY KEY,
    instrumento VARCHAR(60) NOT NULL,
    professor VARCHAR(80) NOT NULL,
    modalidade VARCHAR(30) NOT NULL,
    mensalidade DECIMAL(10,2) NOT NULL,
    horas_mensais INT NOT NULL,
    alunos_matriculados INT NOT NULL
);

